{
  "info": {
    "name": "StudyPilot API",
    "_postman_id": "studypilot-collection-v1",
    "description": "Complete Postman Collection for StudyPilot - Personal AI Learning Agent",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "subjectId",
      "value": "",
      "type": "string"
    },
    {
      "key": "conversationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "quizId",
      "value": "",
      "type": "string"
    },
    {
      "key": "questionId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Krishu Kumar\",\n  \"email\": \"krishu@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"krishu@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Profile (/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Subjects & Topics",
      "item": [
        {
          "name": "Create Subject",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data.subject) {",
                  "    pm.collectionVariables.set('subjectId', jsonData.data.subject.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Database Systems\",\n  \"description\": \"Relational DBs, normal forms, indexing, ACID\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/subjects",
              "host": ["{{baseUrl}}"],
              "path": ["api", "subjects"]
            }
          }
        },
        {
          "name": "Get All Subjects",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/subjects",
              "host": ["{{baseUrl}}"],
              "path": ["api", "subjects"]
            }
          }
        },
        {
          "name": "Create Topic Under Subject",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Normalization\",\n  \"description\": \"1NF, 2NF, 3NF, BCNF\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/subjects/{{subjectId}}/topics",
              "host": ["{{baseUrl}}"],
              "path": ["api", "subjects", "{{subjectId}}", "topics"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Documents & RAG",
      "item": [
        {
          "name": "Upload Document (PDF / TXT / MD)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "title",
                  "value": "DBMS Chapter 3 - Normalization",
                  "type": "text"
                },
                {
                  "key": "subjectId",
                  "value": "{{subjectId}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/documents/upload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "documents", "upload"]
            }
          }
        },
        {
          "name": "Get All Documents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/documents",
              "host": ["{{baseUrl}}"],
              "path": ["api", "documents"]
            }
          }
        },
        {
          "name": "Semantic Vector Search",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"What is third normal form?\",\n  \"limit\": 3,\n  \"minSimilarity\": 0.2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/search/semantic",
              "host": ["{{baseUrl}}"],
              "path": ["api", "search", "semantic"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Socratic AI Chat Tutor",
      "item": [
        {
          "name": "Create Chat Conversation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data.conversation) {",
                  "    pm.collectionVariables.set('conversationId', jsonData.data.conversation.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"DBMS Normalization Study Session\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/conversations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conversations"]
            }
          }
        },
        {
          "name": "Send Message to AI Tutor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Can you explain the difference between 2NF and 3NF?\",\n  \"subjectId\": \"{{subjectId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/conversations/{{conversationId}}/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conversations", "{{conversationId}}", "messages"]
            }
          }
        },
        {
          "name": "Get Conversation History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/conversations/{{conversationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conversations", "{{conversationId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Active Recall & Quizzes",
      "item": [
        {
          "name": "Generate Quiz",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data.quiz) {",
                  "    pm.collectionVariables.set('quizId', jsonData.data.quiz.id);",
                  "    if (jsonData.data.quiz.questions && jsonData.data.quiz.questions.length > 0) {",
                  "        pm.collectionVariables.set('questionId', jsonData.data.quiz.questions[0].id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topicName\": \"Normalization in DBMS\",\n  \"subjectId\": \"{{subjectId}}\",\n  \"count\": 2,\n  \"difficulty\": \"intermediate\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/quizzes/generate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quizzes", "generate"]
            }
          }
        },
        {
          "name": "Submit Quiz Answers & Get AI Evaluation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [\n    {\n      \"questionId\": \"{{questionId}}\",\n      \"userAnswer\": \"3NF eliminates transitive dependencies where non-prime attributes depend on other non-prime attributes.\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/quizzes/{{quizId}}/submit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quizzes", "{{quizId}}", "submit"]
            }
          }
        },
        {
          "name": "Get Quiz Detailed Results",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/quizzes/{{quizId}}/results",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quizzes", "{{quizId}}", "results"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Progress & Mastery Dashboard",
      "item": [
        {
          "name": "Get Dashboard Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/progress/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["api", "progress", "dashboard"]
            }
          }
        },
        {
          "name": "Get Weak Topics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/progress/weak-topics",
              "host": ["{{baseUrl}}"],
              "path": ["api", "progress", "weak-topics"]
            }
          }
        },
        {
          "name": "Log Study Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subjectName\": \"Database Systems\",\n  \"topicName\": \"Normalization\",\n  \"durationMin\": 45,\n  \"summary\": \"Studied 1NF to BCNF and took active recall quiz.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/progress/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "progress", "sessions"]
            }
          }
        }
      ]
    }
  ]
}
